{
  "manifest_version": 3,
  "name": "Tidy Bookmarks",
  "version": "1.0.0",
  "description": "A tidy new-tab bookmark dashboard that keeps nested folders organized and archives old clients out of the way.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks", "storage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
